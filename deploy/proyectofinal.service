[Unit]
Description=ProyectoFinal Pinterest Clone API
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/proyectofinal/backend
EnvironmentFile=/var/www/proyectofinal/backend/.env
ExecStart=/var/www/proyectofinal/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
